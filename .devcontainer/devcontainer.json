{
  "name": "Android Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    "ghcr.io/NordcomInc/devcontainer-features/android-sdk:2.0.0": {
      "platform": "36",
      "build_tools": "36.0.0",
      "disable_openjdk_installation": true
    }
  },
  "postCreateCommand": "yes | sdkmanager --licenses"
}
